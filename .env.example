# Jarvis's own Postgres database — separate from any OTT deployment's DB.
DATABASE_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis?schema=public

# Signs the jarvis_session cookie (jose HS256). Generate with: openssl rand -base64 48
JARVIS_SESSION_SECRET=

# Bootstrap admin, read by `pnpm seed`.
SEED_ADMIN_EMAIL=admin@jarvis.local
SEED_ADMIN_PASSWORD=changeme123

# Local checkout of the OTT platform repo — ops/deploy.sh is invoked from here
# as a child process, driven over SSH using Jarvis's own dedicated identity
# (see JARVIS_SSH_KEY_PATH below) — never the process user's personal one.
OTT_REPO_PATH=/srv/ott-repo

# Jarvis's own SSH keypair, generated automatically on first use if this path
# doesn't exist yet. Deliberately not the process user's default identity
# (~/.ssh/id_ed25519), which may already be a human operator's personal login
# key to this box — automating over that would conflate the two.
# Default: ~/.ssh/jarvis_ed25519
JARVIS_SSH_KEY_PATH=

# Where Jarvis records host keys it has trust-on-first-use accepted for
# registered deployments. Kept separate from the operator's own
# ~/.ssh/known_hosts so Jarvis's automated accept-new behavior only ever
# touches entries it manages itself. Default: ~/.ssh/jarvis_known_hosts
JARVIS_SSH_KNOWN_HOSTS_PATH=

# The `sshpass` binary must be installed on this host (apt install sshpass /
# brew install hudochenkov/sshpass/sshpass) for the password-bootstrap path —
# registering a server that starts out password-only, where Jarvis uses the
# password once to install its own key. Not required if you instead add
# Jarvis's public key (shown in the deployments UI) to a target's
# authorized_keys yourself.

# Used by POST /api/watcher/ingest (the FTP scanner agents' entry point) to
# resolve a parsed folder title to real metadata before fanning it out.
# Without this set, TMDB lookup is skipped entirely and every ingested title
# lands unpublished (the same fail-safe as an unconfident match) rather than
# erroring. Same TMDB account as the OTT repo's own TMDB_API_KEY, but this is
# Jarvis's own copy — the lookup happens centrally, once, here, not per box.
TMDB_API_KEY=
