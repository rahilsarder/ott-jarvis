# Jarvis's own Postgres database — separate from any OTT deployment's DB.
DATABASE_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis?schema=public

# Signs the jarvis_session cookie (jose HS256). Generate with: openssl rand -base64 48
JARVIS_SESSION_SECRET=

# Bootstrap admin, read by `pnpm seed`.
SEED_ADMIN_EMAIL=admin@jarvis.local
SEED_ADMIN_PASSWORD=changeme123

# Local checkout of the OTT platform repo — ops/deploy.sh is invoked from here
# as a child process. Jarvis's own SSH keypair (the process user's default
# identity) must already be authorized on every registered deployment's box.
OTT_REPO_PATH=/srv/ott-repo
